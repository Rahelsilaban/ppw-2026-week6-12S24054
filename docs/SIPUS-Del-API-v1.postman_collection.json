  "item": [
    {
      "name": "1. SOAP Services",
      "item": [
        {
          "name": "1.1 GET SOAP WSDL Contract",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/soap/sipus.wsdl",
              "host": ["{{base_url}}"],
              "path": ["soap", "sipus.wsdl"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Content-Type is text/xml', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/xml');",
                  "});",
                  "pm.test('WSDL contains definitions and CheckClearanceStatus', function () {",
                  "    pm.expect(pm.response.text()).to.include('<definitions');",
                  "    pm.expect(pm.response.text()).to.include('CheckClearanceStatusRequest');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 POST SOAP Envelope - Check Clearance (Success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:sip=\"http://sipus.del.ac.id/soap\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <sip:CheckClearanceStatusRequest>\n         <sip:nim_peminjam>12S24054</sip:nim_peminjam>\n      </sip:CheckClearanceStatusRequest>\n   </soapenv:Body>\n</soapenv:Envelope>"
            },
            "url": {
              "raw": "{{base_url}}/soap/sipus",
              "host": ["{{base_url}}"],
              "path": ["soap", "sipus"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('SOAP response contains clearance status', function () {",
                  "    pm.expect(pm.response.text()).to.include('CheckClearanceStatusResponse');",
                  "    pm.expect(pm.response.text()).to.include('is_cleared');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 POST SOAP Fault - Malformed XML",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<broken-xml><unclosed-tag>"
            },
            "url": {
              "raw": "{{base_url}}/soap/sipus",
              "host": ["{{base_url}}"],
              "path": ["soap", "sipus"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 500 for SOAP Fault', function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "pm.test('Response is SOAP Fault', function () {",
                  "    pm.expect(pm.response.text()).to.include('faultcode');",
                  "    pm.expect(pm.response.text()).to.include('SOAP-ENV:Client');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
